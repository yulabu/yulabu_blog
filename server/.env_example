DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=你的MySQL密码
DB_NAME=blog
PORT=3000
JWT_SECRET=blog_admin_jwt_secret_key_2026
# JWT 有效期（默认 7d）。签发与验签共用同一份配置（config/auth.js）
# JWT_EXPIRES_IN=7d
# 上传目录（默认 <仓库根>/uploads；生产为 /var/www/yulabu_blog/uploads）
# UPLOAD_DIR=/var/www/yulabu_blog/uploads
UPLOAD_MAX_SIZE=5242880
# 单张图片大小上限 5MB（UPLOAD_MAX_SIZE，单位字节）；以下各项不设即用默认值
# 单次请求总大小上限（默认 20MB；生产被 nginx 的 10m 先拦）
# UPLOAD_MAX_TOTAL_SIZE=20971520
# 单次请求张数上限（默认 50，前端 uploadImages 已分片，这里只是护栏）
# UPLOAD_MAX_FILES=50
# 缩略图宽度（默认 400，高度按比例）与 webp 质量（默认 85）
# THUMB_WIDTH=400
# IMAGE_QUALITY=85
SEED_ADMIN_NAME=adminname
SEED_ADMIN_PASSWORD=adminpwd
# 备份目录（默认 <仓库根>/backups）
# BACKUP_DIR=/var/www/yulabu_blog/backups
# 备份 dump 保留份数（默认 30）
# BACKUP_KEEP=30
#
# ---- 音乐歌单（网易云，见 AGENTS.md「音乐歌单」一节）----
# 歌单 ID：歌单页 URL 里的 playlist?id=XXXXX（分享链接里的 uct2= 不需要）。
# 多个歌单用逗号分隔；不设 = 音乐功能整体关闭（接口返回空列表，前端播放器只用本地默认曲目）
# NETEASE_PLAYLIST_IDS=18468162425
# MUSIC_U cookie（可选）：公开歌单不需要它；填了才能读私有歌单、解析 VIP 曲目的直链。
# 属账号凭据——只进 .env，别提交、别贴聊天。整串值含 ; 与 =，必须用引号包起来：
# NETEASE_COOKIE="MUSIC_U=xxxxx; __csrf=yyyyy"
# 网易云 API 根地址（默认官方）。留作预案：切自建 NeteaseCloudMusicApi 实例时改这里
# NETEASE_API_BASE=https://music.163.com
# 固定用这个 IP 充当 X-Real-IP（默认空 = 转发访客真实 IP）。
# 本服务器在境外，网易云按该头判地区：转发访客 IP = 大陆访客天然可播；
# 填一个大陆 IP（如 223.5.5.5）则海外访客也能听全——但那是以大陆 IP 名义请求（绕过地区校验，风险自担）
# NETEASE_REGION_IP=
#
# 必填项（缺失时服务启动即失败，报错写明缺哪个）：DB_NAME / DB_USER / JWT_SECRET
# 唯一读这些变量的是 server/config/env.js（后端唯一 process.env 出口）