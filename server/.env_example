DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=你的MySQL密码
DB_NAME=blog
PORT=3000
JWT_SECRET=blog_admin_jwt_secret_key_2026
UPLOAD_DIR=/var/lib/yulabu/uploads
UPLOAD_MAX_SIZE=5242880
# 单张图片大小上限 5MB（UPLOAD_MAX_SIZE）；单次请求总大小上限 20MB（UPLOAD_MAX_TOTAL_SIZE）
# 单次请求张数上限（默认 50，前端 uploadImages 已分片，这里只是护栏）
# UPLOAD_MAX_FILES=50
SEED_ADMIN_NAME=adminname
SEED_ADMIN_PASSWORD=adminpwd
# 备份目录（默认 <仓库根>/backups）
# BACKUP_DIR=/var/www/yulabu_blog/backups
# 备份 dump 保留份数（默认 30）
# BACKUP_KEEP=30