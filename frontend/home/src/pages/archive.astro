---
import Layout from '@/layouts/Layout.astro'
import PageFrame from '@/components/astro/PageFrame.astro'
import ArchiveView from '@/islands/ArchiveView.vue'
import { getArchive } from '@/api/post'
import { apiSoft } from '@/api/client'
// Cormorant Garamond Italic：只给归档页的 Archive / 年份 / 月份等英文与数字点缀；
// 与 columns / post / about 页一样按页引入，不做全站字体增重
import '@fontsource/cormorant-garamond/600-italic.css'

// 构建期取数：预渲染产物 HTML 里直接带完整归档（后端不可达时传空数组，
// 岛内退化为客户端取数）
const archive = await apiSoft(getArchive())
---

<Layout title="文章归档">
  <!-- 左栏由页面骨架提供：常驻个人卡片会从首页整块搬到这里（同一个 persist key），
       位置正好是原 ArchiveView 里预留的空位。rail 槽留空——归档页左栏除了卡片不放别的。 -->
  <PageFrame variant="archive">
    <ArchiveView client:load initialArchives={archive?.archives ?? []} />
  </PageFrame>
</Layout>
