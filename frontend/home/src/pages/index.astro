---
import Layout from '@/layouts/Layout.astro'
import PageFrame from '@/components/astro/PageFrame.astro'
import HomeHero from '@/components/home/HomeHero.vue'
import TagBox from '@/components/home/TagBox.vue'
import HomeView from '@/views/HomeView.vue'
import { fetchPosts, fetchTags } from '@/utils/serverData'

// 构建期取数：预渲染产物 HTML 里直接带真实内容（取数失败时传空值，
// 岛内会退化为客户端取数，不会白屏）。
// limit 必须与 PostList 里的 PAGE_SIZE 一致，否则烘焙切片与对账切片不同、
// 指纹永不相等 → 每次访问都无谓重绘
const [posts, tags] = await Promise.all([fetchPosts(1, 8), fetchTags()])
---

<Layout>
  <!-- 页面骨架提到 Astro 层：常驻个人卡片靠 .astro 里的 transition:persist 才能跨页
       （写在 Vue SFC 里 Astro 不会识别）。Hero 一并搬到 banner 槽，保持
       「刊头全宽 + 下方两列」的原结构。

       注意 slot 属性要挂在普通元素上，不能直接挂在 Vue 岛组件上：
       Astro 传给框架组件的 slot 会作为 fallthrough 属性进入 Vue 渲染，
       而服务端渲染时 Astro 不会输出该属性 → 水合属性不匹配告警（实测）。 -->
  <PageFrame>
    <div slot="banner">
      <!-- 首页招牌，原样保留：全屏高度、滚动折叠、Navbar 联动都不动。
           client:visible 而不是 client:load：移动端 `.home-hero{display:none}`
           （HomeHero.vue 的 ≤768px 规则），元素永不可见 → IntersectionObserver
           永不触发 → 移动端完全不下发这个岛（含它内部的 WelcomeBanner）的 JS，
           也不再白挂 scroll 监听与打字机定时器。桌面端首屏可见，立即水合。
           注意：若以后把 hero 改回在窄屏可见，这里必须同步改回 client:load。 -->
      <HomeHero client:visible />
    </div>
    <div slot="rail">
      <!-- 标签筛选跟随常驻卡片放在左栏；它与中栏 PostList 分属不同岛，
           通过 stores/tagFilter.ts 的模块级共享状态联通。
           client:visible：左栏在 ≤1024px 是 display:none（PageFrame 的规则），
           窄屏这个实例永不水合 —— 移动端真正的标签 UI 是 HomeView 内那个
           （.mobile-tag-box），所以这里既不缺功能，又少了一个岛的水合和
           一次重复的 GET /api/tags。 -->
      <TagBox client:visible initialTags={tags ?? []} />
    </div>
    <HomeView client:load initialPosts={posts ?? {}} initialTags={tags ?? []} />
  </PageFrame>
</Layout>

