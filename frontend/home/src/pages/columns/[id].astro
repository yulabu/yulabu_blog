---
// 专栏详情：按需渲染（SSR），服务端取数拼出完整 HTML 与 og 标签
export const prerender = false

import Layout from '@/layouts/Layout.astro'
import PageFrame from '@/components/astro/PageFrame.astro'
import ColumnDetailView from '@/islands/ColumnDetailView.vue'
import ColumnCdSplash from '@/components/columns/ColumnCdSplash.vue'
// 与文章页同一套止血策略（404 才走 404 页 / 其余重试一次再抛错），策略实现在 api/client.ts
import { tryGetColumnDetail } from '@/api/column'
// 自托管 Cormorant Garamond 600 italic（latin 子集），仅本页引入：
// Back to Columns / Track List 小标 / Track 序号用；不含 CJK，中文回落文楷
import '@fontsource/cormorant-garamond/600-italic.css'

const { id } = Astro.params

let column = null
let detailStatus = 404

if (/^\d+$/.test(id ?? '')) {
  const attempt = await tryGetColumnDetail(Number(id))
  detailStatus = attempt.ok ? 200 : attempt.status
  if (attempt.ok) column = attempt.data
}

if (!column) {
  if (detailStatus !== 404) {
    throw new Error(`专栏详情取数失败（HTTP ${detailStatus}），后端可能不可用或被限流`)
  }
  return Astro.rewrite('/404')
}

const description = column.desc || `专栏「${column.name}」共 ${column.posts.length} 篇文章`
const ogImage = column.cover || '/og-image.jpg'
---

<Layout title={column.name} description={description} ogImage={ogImage}>
  <!-- withRail：详情页归队左栏个人卡片 persist 家族（与专栏列表同 key personal-card），
       CD 揭幕换页时卡片同位置存活；≤1024px 左栏由 PageFrame 隐藏 -->
  <PageFrame variant="column-detail">
    <ColumnDetailView client:load initialColumn={column} columnId={column.id} />
  </PageFrame>
  <!-- CD 转场常驻岛：与 columns/index.astro 声明同一个 persist key，飞行碟从
       列表页跨页活到这里收第二幕（persist 挂普通 div，纪律同 MusicPlayer/PostSplash） -->
  <div transition:persist="column-cd-splash">
    <ColumnCdSplash client:only="vue" />
  </div>
</Layout>
