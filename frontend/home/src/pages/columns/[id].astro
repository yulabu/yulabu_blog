---
// 专栏详情：按需渲染（SSR），服务端取数拼出完整 HTML 与 og 标签
export const prerender = false

import Layout from '@/layouts/Layout.astro'
import ColumnDetailView from '@/views/ColumnDetailView.vue'

// SSR 服务端取数走本机后端（生产由 pm2 注入 API_BASE_URL）
const API_BASE = process.env.API_BASE_URL || 'http://127.0.0.1:3000/api'
const { id } = Astro.params

let column = null
let detailStatus = 404

// 与文章页同一套止血策略（2026-10）：只有 404 走 404 页；429/5xx/网络错重试一次，
// 仍失败就抛错（5xx）——改前一律 rewrite('/404')，后端不可用时会谎称专栏不存在
async function fetchJson(path) {
  const res = await fetch(`${API_BASE}${path}`)
  return res.ok ? { ok: true, data: await res.json() } : { ok: false, status: res.status }
}

if (/^\d+$/.test(id ?? '')) {
  const path = `/columns/${id}`
  let attempt = await fetchJson(path).catch(() => ({ ok: false, status: 0 }))
  if (!attempt.ok && attempt.status !== 404) {
    attempt = await fetchJson(path).catch(() => ({ ok: false, status: 0 }))
  }
  detailStatus = attempt.ok ? 200 : attempt.status
  if (attempt.ok) column = attempt.data
}

if (!column) {
  if (detailStatus !== 404) {
    throw new Error(`专栏详情取数失败（HTTP ${detailStatus}），后端可能不可用或被限流`)
  }
  return Astro.rewrite('/404')
}

const description = column.desc || `专栏「${column.name}」共 ${column.posts.length} 篇文章`
const ogImage = column.cover || '/og-image.jpg'
---

<Layout title={column.name} description={description} ogImage={ogImage}>
  <ColumnDetailView client:load initialColumn={column} />
</Layout>
