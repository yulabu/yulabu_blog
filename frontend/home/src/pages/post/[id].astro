---
// 文章详情：按需渲染（SSR）——服务端取数拼出完整 HTML（正文 + per-post og 标签）
// 文章过渡卡片由常驻岛 PostSplash.vue 在点击瞬间渲染，不再烘焙进本页
export const prerender = false

import Layout from '@/layouts/Layout.astro'
import PostDetailView from '@/views/PostDetailView.vue'

// SSR 服务端取数走本机后端（生产由 pm2 注入 API_BASE_URL）
const API_BASE = process.env.API_BASE_URL || 'http://127.0.0.1:3000/api'
const { id } = Astro.params

let post = null
let prevPost = null
let nextPost = null
// 评论区总开关（后台「系统设置」）；读不到就按开启处理，与本站其它取数一样 fail-soft
let commentsEnabled = true

if (/^\d+$/.test(id ?? '')) {
  try {
    const res = await fetch(`${API_BASE}/posts/${id}`)
    if (res.ok) {
      post = await res.json()
      const [prev, next, settings] = await Promise.all([
        fetch(`${API_BASE}/posts/${id}/prev`).then((r) => (r.ok ? r.json() : null)).catch(() => null),
        fetch(`${API_BASE}/posts/${id}/next`).then((r) => (r.ok ? r.json() : null)).catch(() => null),
        fetch(`${API_BASE}/settings`).then((r) => (r.ok ? r.json() : null)).catch(() => null),
      ])
      prevPost = prev?.post ?? null
      nextPost = next?.post ?? null
      commentsEnabled = settings?.comments_enabled !== false
    }
  } catch {
    // 后端不可达时按 404 处理
  }
}

if (!post) {
  return Astro.rewrite('/404')
}

const description = post.summary || '纳西妲世界第一可爱'
const ogImage = post.cover || '/og-image.jpg'
---

<Layout title={post.title} description={description} ogImage={ogImage}>
  <PostDetailView
    client:load
    postId={post.id}
    initialPost={post}
    initialPrev={prevPost}
    initialNext={nextPost}
    commentsEnabled={commentsEnabled}
  />

</Layout>

