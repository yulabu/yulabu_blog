---
// 按需渲染：SSR 页（post/[id] 等）Astro.rewrite('/404') 需要本路由存在服务端实例
export const prerender = false

import Layout from '@/layouts/Layout.astro'
---

<Layout title="页面不存在">
  <main class="not-found">
    <p class="code">404</p>
    <p class="text">这里什么都没有……</p>
    <a class="home" href="/">返回首页</a>
  </main>
</Layout>

<style>
  .not-found {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 12px;
    background: var(--bg-page);
  }

  .code {
    font-family: Georgia, serif;
    font-size: 72px;
    font-weight: 700;
    color: var(--color-primary);
    line-height: 1;
  }

  .text {
    font-size: 14px;
    color: var(--color-text);
  }

  .home {
    margin-top: 12px;
    padding: 8px 20px;
    border-radius: 999px;
    background: var(--color-primary);
    color: #fff;
    text-decoration: none;
    font-size: 14px;
  }

  .home:hover {
    background: var(--color-primary-hover);
  }
</style>
