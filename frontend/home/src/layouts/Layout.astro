---
import '@/main.css'
// 服务端注册离线图标 + md-editor 本地扩展（SSR 正文代码块同步高亮；
// 客户端由 _app.ts 注册）
import '@/utils/icons'
import '@/utils/mdEditorSetup'
// LXGW 文楷：只取 regular + bold（Mono 三档与 Light 一档全站零引用），
// 并用 ?url 让它成为独立可寻址资产，在 <head> 里非阻塞加载（见下方 fontCssLinks 一段）。
// 不能写进 main.css 的 @import：那样会与全局样式合并成一个渲染阻塞样式表。
import fontRegularCss from 'lxgw-wenkai-webfont/lxgwwenkai-regular.css?url'
import fontBoldCss from 'lxgw-wenkai-webfont/lxgwwenkai-bold.css?url'
import { ClientRouter } from 'astro:transitions'
import Navbar from '@/components/common/Navbar.vue'
import SiteFooter from '@/components/astro/SiteFooter.astro'
import MessageBox from '@/components/common/MessageBox.vue'
import MusicPlayer from '@/components/common/MusicPlayer.vue'
import PostSplash from '@/components/common/PostSplash.vue'

interface Props {
  title?: string
  description?: string
  ogImage?: string
}

const SITE_NAME = '鱼辣不的博客'
const SITE_DESCRIPTION = '纳西妲世界第一可爱'
const SITE_IMAGE = '/og-image.jpg'

// 字体样式表：桌面与移动**统一加载**，不按视口区分。
// 唯一砍掉的是真正用不上的部分：只引 regular + bold 两档 —— Mono 三档与 Light 一档
// 经全站 grep（font-family / font-weight）确认零引用，582 条 @font-face → 194 条，
// 字体 CSS 565 KB → 183 KB。
// 加载方式：media="print" + onload 切成 all（经典 loadCSS 手法）—— 非阻塞、低优先级，
// 字体本来就不该抢首屏带宽。字体 CSS 只含 @font-face、没有任何布局规则，且每条都是
// font-display: swap，所以首屏先用系统中文字体出字、文楷到达后替换。
// <noscript> 兜底给禁用 JS 的访客（那时 onload 不会触发）。
const fontCssUrls = [fontRegularCss, fontBoldCss]

const { title, description = SITE_DESCRIPTION, ogImage = SITE_IMAGE } = Astro.props
const site = Astro.site ?? new URL('https://blog.yulabu.cn')
const pageTitle = title ? `${title} | ${SITE_NAME}` : SITE_NAME
const canonical = new URL(Astro.url.pathname, site)
const ogImageURL = new URL(ogImage, site)
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <!-- 图标用 PNG（浏览器对 webp favicon 支持不完整）：原 256x256 .ico 有 243 KB -->
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:locale" content="zh_CN" />
    <meta name="twitter:card" content="summary_large_image" />
    {fontCssUrls.map((href) => (
      <link rel="stylesheet" href={href} media="print" onload="this.setAttribute('media','all')" />
    ))}
    <noscript>
      {fontCssUrls.map((href) => <link rel="stylesheet" href={href} />)}
    </noscript>
    <script is:inline>
      // 首帧前恢复客户端专属状态，防闪烁/弹跳（key 与 stores/ui.ts 的
      // THEME_KEY / HOME_HERO_COLLAPSED_KEY 保持一致）；
      // ClientRouter 软导航 swap 后 html 属性会被新文档覆盖，需在 astro:after-swap 重挂
      function applyClientState() {
        var root = document.documentElement
        try {
          root.dataset.theme = localStorage.getItem('theme') || 'light'
        } catch (e) { /* 无 localStorage 时静默降级 */ }
        try {
          // 首页全屏 Hero：折叠态会话的首帧直接以 360px 渲染（配合 HomeHero
          // 的 html[data-hero-collapsed] CSS），避免水合后 0.8s 折叠动画的弹跳
          if (sessionStorage.getItem('homeHeroCollapsed') === 'true') {
            root.dataset.heroCollapsed = 'true'
          } else {
            delete root.dataset.heroCollapsed
          }
        } catch (e) { /* 无 sessionStorage 时静默降级 */ }
      }
      applyClientState()
      document.addEventListener('astro:after-swap', applyClientState)
    </script>
    <ClientRouter />
  </head>
  <body>
    <Navbar client:load currentPath={Astro.url.pathname} />
    <slot />
    <SiteFooter />
    <!-- client:only：MessageBox 根节点是 Teleport to body，SSR 水合会在 body 内
         触发 mismatch 清理、误删相邻岛（实测删过 Navbar），且弹窗初始无需服务端渲染 -->
    <MessageBox client:only="vue" />
    <!-- persist 挂在普通包装元素上：整块搬运保留播放器状态（含 audio 不中断），
         避免 client:only 岛在 swap 中被单独 moveBefore 触发的边界问题 -->
    <div transition:persist="music-player">
      <MusicPlayer client:only="vue" />
    </div>
    <!-- 文章过渡卡片：点击瞬间弹出、跨页连续显示的常驻遮罩岛（persist 包装同 MusicPlayer） -->
    <div transition:persist="post-splash">
      <PostSplash client:only="vue" />
    </div>
    <script>
      import { useAnimatedCursor } from '@/composables/useAnimatedCursor'
      import { useDayPeriod } from '@/composables/useDayPeriod'

      const cursor = useAnimatedCursor()
      const dayPeriod = useDayPeriod()

      function startEffects() {
        // armCursors 而非 initCursors：首次指针交互才真正拉 .ani 并生成光标样式
        // （首屏零请求零注入，理由见 useAnimatedCursor.ts 的按需初始化注释）
        cursor.armCursors()
        dayPeriod.start()
      }

      startEffects()
      // ClientRouter 软导航：head 与 html 属性会被新文档整段替换（注入的光标 <style>
      // 被移除、html 上的 data-period 被清掉），after-swap 在浏览器取新快照前触发，
      // 此时补回不会被拍到；两个 composable 内部均有幂等守卫，重复调用安全
      // （armCursors 已初始化时退回 ensureInjected，把被 swap 掉的光标样式补回来）
      document.addEventListener('astro:after-swap', startEffects)
      document.addEventListener('astro:page-load', startEffects)
    </script>
  </body>
</html>
